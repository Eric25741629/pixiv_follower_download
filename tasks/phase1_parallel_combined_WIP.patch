+
+
+_FORWARDER_DROP_TYPES = frozenset({"page_progress", "progress", "phase"})
+
+
+class _ConcurrentEventForwarder:
+    """Installed once as fetcher._q and downloader._q during concurrent combined
+    mode. Drops engine events that are meaningless or fight the UI under K-way
+    concurrency (per-page progress, the fetcher's bogus overall progress, and
+    per-PID phase labels); forwards everything else to the real queue. The
+    coordinator emits overall progress / aggregate phase straight to the real
+    queue. Stateless and lock-free — filtering is identical for every thread."""
+
+    def __init__(self, real_q):
+        self._real_q = real_q
+
+    def put(self, ev, *args, **kwargs):
+        try:
+            if getattr(ev, "type", None) in _FORWARDER_DROP_TYPES:
+                return
+        except Exception:
+            pass
+        try:
+            self._real_q.put(ev)
+        except Exception:
+            pass
